{
  "hosting": [
    {
      "target": "parkscreen",
      "public": "web/client/dist",
      "ignore": ["firebase.json", "**/.*"],
      "headers": [
        {
          "source": "/assets/**",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
        },
        {
          "source": "**/*.html",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        }
      ]
    },
    {
      "target": "parkscreen-releases",
      "public": "Releases",
      "ignore": ["firebase.json", "**/.*"],
      "headers": [
        {
          "source": "**",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        }
      ]
    }
  ]
}
