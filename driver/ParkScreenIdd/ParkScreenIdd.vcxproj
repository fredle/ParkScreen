<?xml version="1.0" encoding="utf-8"?>
<!-- Needs Visual Studio 2022 with the C++ desktop workload and the Windows Driver Kit (WDK) headers
     and libraries. No Visual Studio extension is needed: this is a plain DLL project that adds the
     UMDF and IddCx include and library paths itself, so it also builds on CI runners that only
     have the kit installed.
     Build: msbuild ParkScreenIdd.vcxproj /p:Configuration=Release /p:Platform=x64 -->
<Project DefaultTargets="Build" ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{5C0B7E1A-2D84-4B63-9F3E-7A1D6C5E8B20}</ProjectGuid>
    <RootNamespace>ParkScreenIdd</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <TemplateGuid>{f2f62967-0815-4fd7-9b86-6eedcac766eb}</TemplateGuid>
    <Keyword>Win32Proj</Keyword>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
    <SpectreMitigation>false</SpectreMitigation>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
    <UseDebugLibraries>true</UseDebugLibraries>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <UseDebugLibraries>false</UseDebugLibraries>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <TargetName>ParkScreenIdd</TargetName>
    <GenerateManifest>false</GenerateManifest>
    <UmdfVersion>2.25</UmdfVersion>
    <IddCxVersion>1.4</IddCxVersion>
    <WdkRoot>$(WindowsSdkDir)</WdkRoot>
    <WdkRoot Condition="'$(WdkRoot)'==''">$(MSBuildProgramFiles32)\Windows Kits\10\</WdkRoot>
    <WdkSdkVersion>$(TargetPlatformVersion)</WdkSdkVersion>
    <WdkSdkVersion Condition="'$(WdkSdkVersion)'=='' or '$(WdkSdkVersion)'=='10.0'">10.0.26100.0</WdkSdkVersion>
    <IncludePath>$(WdkRoot)Include\wdf\umdf\$(UmdfVersion);$(WdkRoot)Include\$(WdkSdkVersion)\um\iddcx\$(IddCxVersion);$(IncludePath)</IncludePath>
    <LibraryPath>$(WdkRoot)Lib\wdf\umdf\x64\$(UmdfVersion);$(WdkRoot)Lib\$(WdkSdkVersion)\um\x64\iddcx\$(IddCxVersion);$(LibraryPath)</LibraryPath>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>false</TreatWarningAsError>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <!-- IddCx 1.4: Windows 10 2004 and later. -->
      <PreprocessorDefinitions>IDDCX_VERSION_MAJOR=1;IDDCX_VERSION_MINOR=4;IDD_IS_FUNCTION_PRESENT_CHECKED;UMDF_VERSION_MAJOR=2;UMDF_VERSION_MINOR=25;UMDF_USING_NTSTATUS;_AMD64_;_WINDLL;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalDependencies>d3d11.lib;dxgi.lib;ole32.lib;ntdll.lib;WdfDriverStubUm.lib;IddCxStub.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <!-- UMDF 2 entry point from WdfDriverStubUm.lib; it calls DriverEntry. -->
      <EntryPointSymbol>FxDriverEntryUm</EntryPointSymbol>
      <SubSystem>Windows</SubSystem>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="Driver.cpp" />
    <ClCompile Include="Edid.cpp" />
    <ClCompile Include="SwapChain.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="Driver.h" />
    <ClInclude Include="Ioctl.h" />
  </ItemGroup>
  <ItemGroup>
    <None Include="ParkScreenIdd.inf" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
