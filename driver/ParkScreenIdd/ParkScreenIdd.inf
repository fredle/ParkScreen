;
; ParkScreenIdd.inf: ParkScreen virtual display (indirect display driver, UMDF 2)
;

[Version]
Signature   = "$Windows NT$"
Class       = Display
ClassGuid   = {4D36E968-E325-11CE-BFC1-08002BE10318}
Provider    = %ManufacturerName%
CatalogFile = ParkScreenIdd.cat
DriverVer   =
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13
UMDriverCopy   = 13

[SourceDisksNames]
1 = %DiskName%

[SourceDisksFiles]
ParkScreenIdd.dll = 1

[Manufacturer]
%ManufacturerName% = Standard,NT$ARCH$.10.0...16299

[Standard.NT$ARCH$.10.0...16299]
%DeviceName% = ParkScreen_Install, Root\ParkScreenIdd

[ParkScreen_Install.NT]
CopyFiles = UMDriverCopy

[ParkScreen_Install.NT.HW]
AddReg = ParkScreen_HardwareSettings

[ParkScreen_HardwareSettings]
HKR,, "UpperFilters",  %REG_MULTI_SZ%, "IndirectKmd"
HKR, "WUDF", "DeviceGroupId", %REG_SZ%, "ParkScreenIddGroup"
; Local administrators and the system, plus interactive users: the host agent runs without
; administrator rights.
HKR,, Security, %REG_SZ%, "D:P(A;;GA;;;SY)(A;;GA;;;BA)(A;;GRGW;;;IU)"

[ParkScreen_Install.NT.Services]
AddService = WUDFRd,0x000001fa,WUDFRD_ServiceInstall

[ParkScreen_Install.NT.Wdf]
UmdfService              = ParkScreenIdd,UmdfService_Install
UmdfServiceOrder         = ParkScreenIdd
UmdfKernelModeClientPolicy = AllowKernelModeClients
UmdfHostProcessSharing   = ProcessSharingDisabled

[UmdfService_Install]
UmdfLibraryVersion = $UMDFVERSION$
ServiceBinary      = %13%\ParkScreenIdd.dll

[WUDFRD_ServiceInstall]
DisplayName   = %WudfRdDisplayName%
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %12%\WUDFRd.sys

[UMDriverCopy]
ParkScreenIdd.dll

[Strings]
ManufacturerName    = "FBL Consulting Ltd"
DiskName            = "ParkScreen Display Installation Disk"
DeviceName          = "ParkScreen Virtual Display"
WudfRdDisplayName   = "Windows Driver Foundation - User-mode Driver Framework Reflector"
REG_MULTI_SZ        = 0x00010000
REG_SZ              = 0x00000000
